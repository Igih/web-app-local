# Web 访问端口，建议保持默认，避免和旧版 80 端口冲突
WEB_PORT=8080

# 后端直连端口，建议保持默认，避免和旧版 8001 端口冲突
API_PORT=8002

# 数据库配置
POSTGRES_USER=myzpp
POSTGRES_PASSWORD=my123
POSTGRES_DB=mydb
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_WORK_MEM=16MB

# 请替换为新的随机字符串，不要和旧网站相同
SECRET_KEY=change-me-to-a-long-random-secret

# 资源限制，可按服务器配置调整
DB_CPUS=4.0
DB_MEMORY=4G
FRONTEND_CPUS=2.0
FRONTEND_MEMORY=1G
BACKEND_CPUS=8.0
BACKEND_MEMORY=10G
ASSET_WORKER_CPUS=2.0
ASSET_WORKER_MEMORY=1G
QUALITY_WORKER_CPUS=4.0
QUALITY_WORKER_MEMORY=4G

# Worker 轮询间隔，单位秒
ASSET_WORKER_POLL_INTERVAL=5
QUALITY_WORKER_POLL_INTERVAL=5
